{
    "name": "Pascal Development",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": "false"
        }
    },
    "containerEnv": {},
    "customizations": {
        "vscode": {
            "settings": {
                "pascal.formatter.engine": "ptop",
                "pascal.formatter.enginePath": "/usr/bin/ptop",
                "[pascal]": {
                    "editor.defaultFormatter": "alefragnani.pascal-formatter"
                },
                "[objectpascal]": {
                    "editor.defaultFormatter": "alefragnani.pascal-formatter"
                }
            },
            "extensions": [
                "alefragnani.pascal-formatter",
                "alefragnani.pascal"
            ]
        }
    }
}
