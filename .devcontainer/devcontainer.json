{
    "name": "UniFlash C / Open Watcom 2",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": "false"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}"
                ],
                "files.associations": {
                    "*.def": "c"
                }
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.makefile-tools"
            ]
        }
    }
}
